+  # For printing: a negated tuple disjoint from the positive one is dropped, and one
+  # that contains it in every component but one, k, is absorbed into that component:
+  # {p1, ..., pn} and not {n1, ..., nn} = {p1, ..., pk and not nk, ..., pn}.
+  defp tuple_line_absorb_negations({:closed, elements, negs}) do
+    {elements, negs} =
+      Enum.reduce(negs, {elements, []}, fn
+        bdd_leaf(:closed, others) = neg, {elements, kept}
+        when length(others) == length(elements) ->
+          case tuple_negation_effect(elements, others) do
+            :disjoint ->
+              {elements, kept}
+
+            {:component, k} ->
+              {List.update_at(elements, k, &difference(&1, Enum.at(others, k))), kept}
+
+            :kept ->
+              {elements, [neg | kept]}
+          end
+
